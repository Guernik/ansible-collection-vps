# yamlfmt configuration
# https://github.com/google/yamlfmt/blob/main/docs/config-file.md
# Kept aligned with .yamllint so formatter + linter agree.
formatter:
  type: basic
  indent: 2
  include_document_start: true
  retain_line_breaks_single: true
  scan_folded_as_literal: true
  trim_trailing_whitespace: true
  eof_newline: true
  pad_line_comments: 1
  # Don't reflow long lines: Ansible has Jinja blocks where wrapping breaks them.
  max_line_length: 0

include:
  - "**/*.yml"
  - "**/*.yaml"

exclude:
  - ".venv/**"
